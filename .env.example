# Copy this file to .env.local and fill in real values. Never commit the real file.

# Sentry DSNs - separate per runtime (browser vs server/edge).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry build-time config - only needed for source map upload and release tagging.
# The build no-ops without these, so they're optional for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
